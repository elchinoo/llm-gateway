# Copy to .env (git-ignored). LOCAL development only; never commit real credentials.
# Password for the local docker-compose database. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://llmgw:${POSTGRES_PASSWORD}@127.0.0.1:5437/llmgw

# Optional: the public base URL shown in the Connect page (defaults to the request's own address).
# LLMGW_PUBLIC_URL=https://llm-gateway.example.com
# Optional: platform secret that lets the vault unlock itself after a restart (real providers need it).
# LLMGW_ENCRYPTION_KEY=
# Optional: allow provider URLs on localhost/private networks (a local model server; local testing only).
# LLMGW_ALLOW_PRIVATE_URLS=true
# Optional: upstream call timeout in seconds (default 60, max 120) and the sample's default embedding size.
# LLMGW_UPSTREAM_TIMEOUT=60

# Single sign-on with the ecosystem identity provider (https://github.com/elchinoo/identity). Off when the issuer is unset.
# LLMGW_OIDC_ISSUER=https://identity.example.com
# LLMGW_OIDC_CLIENT_ID=llmgw
# LLMGW_OIDC_CLIENT_SECRET=
# LLMGW_LOCAL_LOGIN=false      # remove the admin-password login when SSO is on (default keeps it as break-glass)
